DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-unique-random-value

# Public API origin, without the /api prefix (used to build uploaded-image URLs).
PUBLIC_API_URL=http://127.0.0.1:5000

# Comma-separated exact browser origins allowed to call the API.
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# For production, use HTTPS and set SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
